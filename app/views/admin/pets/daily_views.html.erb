<h1><%= @pet.name %> の日付別アクセス数</h1>

<%= link_to 'ペット詳細に戻る', admin_pet_path(@pet) %>

<table>
  <thead>
    <tr>
      <th>日付</th>
      <th>アクセス数</th>
    </tr>
  </thead>
  <tbody>
    <% @daily_view_counts.each do |date, count| %>
      <tr>
        <td><%= date.strftime('%Y年%m月%d日') %></td>
        <td><%= count %> 回</td>
      </tr>
    <% end %>
  </tbody>
</table>