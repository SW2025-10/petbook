<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chart.js Example</title>
    <!-- Chart.jsライブラリの読み込み -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      /* メインコンテナのスタイル */
      main {
        width: 100%;
        display: flex;
        justify-content: center;
      }
      /* グラフを表示するためのスタイル */
      #js-result {
        display: flex;
        flex-wrap: wrap;
        width: 50%;
        gap: 20px;
        justify-content: center;
      }
      /* キャンバス（グラフ）自体のスタイル */
      canvas {
        flex: 1 0 48%;
        max-width: 100%;
        height: 50vh;
        margin-bottom: 20px;
      }
    </style>
  </head>
  <body>
    <main>
      <!-- グラフを表示するコンテナ -->
      <div id="js-result"></div>
    </main>
    <canvas id="dailyViewsChart"></canvas>

<script>
// ----------------------------------------------------
// RubyデータをJavaScriptで使えるように展開する（重要）
// ----------------------------------------------------

// 1. ラベル（日付）の配列を展開
// to_json を使うことで、Rubyの配列をJavaScriptの配列 [..., ...] に変換します
const chartLabels = <%= @chart_labels.to_json.html_safe %>; 

// 2. データ（カウント数）の配列を展開
const chartData = <%= @chart_data.to_json.html_safe %>; 


// ----------------------------------------------------
// 3. Chart.jsのデータ構造に組み込む
// ----------------------------------------------------
const ctx = document.getElementById('dailyViewsChart').getContext('2d');
const myChart = new Chart(ctx, {
    type: "bar",
    data: {
      // 🔥 ここに Rubyから渡された chartLabels をセット 🔥
      labels: chartLabels, 
      
      datasets: [{
        label: "日別アクセス合計数",
        // 🔥 ここに Rubyから渡された chartData をセット 🔥
        data: chartData,
        
        // 色は一旦シンプルに統一するか、そのまま使います
        backgroundColor: "rgba(54, 162, 235, 0.5)",
        borderColor: "rgba(54, 162, 235, 1)",
        borderWidth: 1,
      }],
    },
    options: {
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'アクセス数 (回)'
          }
        },
        x: {
          title: {
            display: true,
            text: '日付'
          }
        }
      },
    },
});
</script>
  </body>
</html>