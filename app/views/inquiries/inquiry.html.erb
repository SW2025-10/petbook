<h1>お問い合わせ</h1>
<%= form_with(model: @inquiry, url: inquiries_path) do |f| %>
  <p>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= f.label :email, "メールアドレス" %><br>
    <%= f.email_field :email %>
  </p>
  <p>
    <%= f.label :content, "お問い合わせ内容" %><br>
    <%= f.text_area :content %>
  </p>
  <%= f.submit "送信" %>
  <p>
    <%= link_to '一覧に戻る', pets_path %>
  </p>
<% end %>
