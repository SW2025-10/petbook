
<h1>ペット詳細情報: <%= @pet.name %></h1>

<div class="pet-details">
  <% if @pet.main_image.attached? %>
    <%= image_tag @pet.main_image, size: "400x400" %>
  <% else %>
    <p>[画像なし]</p>
  <% end %>

  <ul>
    <li>名前: <%= @pet.name %></li>
    <li>価格: <%= @pet.price %>円</li>
    <li>生年月日: <%= @pet.birthday %></li>
    <li>ラベル: <%= @pet.label %></li>
    <li>コメント: <%= @pet.comment %></li>
  </ul>
</div>

<hr>


<h3>コメントを投稿する</h3>

<%= form_with(model: [@pet, Comment.new], local: true) do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :content, "コメント内容" %><br>
    <%= f.text_area :content %>
  </div>

  <%= f.submit "投稿する" %>
<% end %>

<hr>

<h3>お客様コメント一覧</h3>

<% @pet.comments.order(created_at: :desc).each do |comment| %>
  <p>
    <strong><%= comment.name %></strong>：
    <%= comment.content %><br>
    <small><%= comment.created_at.strftime('%Y/%m/%d %H:%M') %></small>
  </p>
  <hr>
<% end %>




<h2>面会を希望する</h2>
<%= link_to 'このペットの面会をリクエストする', new_pet_meeting_path(@pet) %>

<br>
<%= link_to '一覧に戻る', pets_path %>

